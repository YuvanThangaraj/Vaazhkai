# Public values only (Supabase Dashboard -> Project Settings -> API Keys). Use the PUBLISHABLE key.
# Never put a secret / service_role key here: VITE_* values are shipped to every visitor's browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
